{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "daylog",
  "version": "0.1.0",
  "identifier": "com.ninadk.daylog",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "daylog",
        "label": "main",
        "width": 1000,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Privacy-respecting personal activity logger.",
    "longDescription": "daylog records which applications and windows you use and for how long — timestamped to a local log file — so you can review where your time goes. It never captures keystrokes or typed text. Optional AES-GCM encryption, sensitive-app exclusion, and CSV/Markdown export."
  },
  "plugins": {}
}
