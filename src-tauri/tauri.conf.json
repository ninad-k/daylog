{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "daylog",
  "version": "0.2.2",
  "identifier": "com.ninadk.daylog",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "daylog",
        "label": "main",
        "width": 1000,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "linux": { "deb": { "depends": ["libxss1"] } },
    "shortDescription": "Privacy-respecting personal activity logger.",
    "longDescription": "daylog records application and window focus time locally, with daily and weekly analytics, categories, goals, saved filters, and CSV/Markdown export. Optional Windows text recording requires encrypted storage and explicit approval for selected or all supported apps. Includes idle detection, exclusions, and opt-in email summaries and signed update checks."
  },
  "plugins": {}
}
